# ==============================================================================
# ACADET CBT — RENDER DEPLOYMENT ENVIRONMENT VARIABLES
# ==============================================================================

# Server configuration
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Render Managed PostgreSQL connection string (Internal URL on Render same-region)
# Example: postgres://user:password@dpg-xxxxxxxx-a/acadet_cbt
DATABASE_URL=

# Set to "true" if connecting to external PostgreSQL requiring TLS/SSL
DATABASE_SSL=false

# Cryptographic secret for signing JWT authentication tokens (min 32 chars)
JWT_SECRET=replace-with-strong-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# External S3 / Cloudflare R2 / Backblaze B2 Object Storage for PDFs, docs, images
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_URL=

# Optional bootstrap administrator account for initial database setup (db:seed)
ADMIN_FULL_NAME=Acadet Administrator
ADMIN_EMAIL=admin@acadetcbt.website
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional Gemini API key for server-side study question generation
GEMINI_API_KEY=

# Paystack Payment Gateway (Required for live/test course registration payments)
# Use test keys (sk_test_... / pk_test_...) during development and testing
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=
PAYSTACK_WEBHOOK_SECRET=

# Transactional Email API Configuration via Lockally (Password Recovery & Verification)
LOCKALLY_API_KEY=
LOCKALLY_API_URL=https://api.lockally.com/v1
SMTP_FROM_EMAIL=noreply@acadetcbt.website
APP_BASE_URL=https://acadetcbt.website

